# Public site origin used for metadata, robots and sitemap.
# Use the real HTTPS origin after the production domain is ready.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional AI Assistant server-side enhancement.
# Without these values, the assistant uses local Portfolio Knowledge Mode only.
ASSISTANT_API_KEY=
ASSISTANT_MODEL=gpt-5-mini
ASSISTANT_PROVIDER_URL=https://api.openai.com/v1/chat/completions
ASSISTANT_TIMEOUT_MS=8000
